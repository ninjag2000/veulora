FAL_IDENTITY_VIDEO_ECONOMY_MODEL=fal-ai/pixverse/c1/reference-to-video
FAL_PRO_IMAGE_TEXT_MODEL=fal-ai/nano-banana-2
FAL_PRO_IMAGE_REFERENCE_MODEL=fal-ai/nano-banana-2/edit
