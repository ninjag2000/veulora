{
  "expo": {
    "name": "Veloura AI",
    "slug": "veloura-ai",
    "scheme": "veloura",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.codex.veloura",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Allow Veloura AI to save generated images and videos to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0711"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.codex.veloura"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Veloura AI to access your photos for AI generation.",
          "cameraPermission": "Allow Veloura AI to access your camera for AI generation.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Veloura AI to save generated images and videos."
        }
      ],
      "expo-video"
    ]
  }
}
